---
import Header from '../components/Header.astro';
import AiChat from '../components/AiChat.astro';
import VisualEffects from '../components/VisualEffects.astro';
import { SITE, withBase } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  article?: boolean;
}

const { title, description = SITE.description, wide = false, article = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = storedTheme || (prefersDark ? 'dark' : 'light');
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={withBase('/rss.xml')} />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body>
    <VisualEffects article={article} />
    <Header />
    <main class:list={['page-shell', wide && 'page-shell--wide']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>&copy; {new Date().getFullYear()} {SITE.author}. Built with Astro.</p>
        <nav aria-label="页脚链接">
          <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={SITE.email}>Email</a>
        </nav>
      </div>
    </footer>
    <AiChat />
  </body>
</html>
