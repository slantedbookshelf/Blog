---
import type { InferGetStaticPropsType } from 'astro';
import CourseLesson from '../../../components/js-ts/CourseLesson.astro';
import { chapters } from '../../../data/go/chapters';
import { exercises } from '../../../data/go/exercises';
import { tests } from '../../../data/go/test-cases';

export function getStaticPaths() {
  return chapters.flatMap(chapter => chapter.lessons.map(lesson => ({
    params: { id: lesson.id }, props: { chapter, lesson },
  })));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { chapter, lesson } = Astro.props;
---

<CourseLesson courseId="go" courseTitle="Go 语言学习" {chapters} {chapter} {lesson}
  exercise={exercises[lesson.id]} cases={tests[lesson.id]} />
