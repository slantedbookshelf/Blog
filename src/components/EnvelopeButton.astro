---
interface Props { id: string; }
const { id } = Astro.props;
---
<svg viewBox="-50 -50 100 100" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${id}-grain`} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="3" seed="7" result="noise" />
      <feDiffuseLighting in="noise" surfaceScale="1.5" diffuseConstant="1" lighting-color="#fff" result="light"><feDistantLight azimuth="225" elevation="50" /></feDiffuseLighting>
      <feComposite in="light" in2="SourceGraphic" operator="arithmetic" k1=".65" k2="0" k3=".4" k4="0" result="paper" />
      <feComposite in="paper" in2="SourceAlpha" operator="in" />
    </filter>
    <linearGradient id={`${id}-paper`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="white" stop-opacity=".18" /><stop offset=".45" stop-color="white" stop-opacity="0" /><stop offset="1" stop-color="black" stop-opacity=".2" /></linearGradient>
    <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e3ebe7" /><stop offset=".24" stop-color="#8eaaa0" /><stop offset=".48" stop-color="#354c43" /><stop offset=".72" stop-color="#aebfb8" /><stop offset="1" stop-color="#4b6258" /></linearGradient>
    <linearGradient id={`${id}-bevel`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#263c32" /><stop offset=".52" stop-color="#52695d" /><stop offset="1" stop-color="#d3ded6" /></linearGradient>
    <radialGradient id={`${id}-hole`} cx=".65" cy=".75"><stop stop-color="var(--surface)" /><stop offset=".6" stop-color="var(--surface)" /><stop offset="1" stop-color="#0b1710" /></radialGradient>
  </defs>
  <circle r="47" fill="var(--accent)" filter={`url(#${id}-grain)`} />
  <circle r="47" fill={`url(#${id}-paper)`} stroke="white" stroke-opacity=".25" stroke-width=".6" />
  <circle r="17" fill="none" stroke="black" stroke-opacity=".15" stroke-width="1" />
  <circle r="16" fill="none" stroke="white" stroke-opacity=".12" stroke-width=".7" />
  <circle cy=".7" r="13.6" fill="#0a1811" fill-opacity=".45" />
  <circle r="13" fill={`url(#${id}-metal)`} stroke="#30473c" stroke-width=".6" />
  <circle r="9.1" fill={`url(#${id}-bevel)`} />
  <circle r="6.6" fill={`url(#${id}-hole)`} stroke="#20342a" stroke-width=".7" />
  <path d="M-8.5-6.2 A10.5 10.5 0 0 1 -1.5-10.3" fill="none" stroke="#f2f6f3" stroke-opacity=".9" stroke-width="1.3" stroke-linecap="round" />
  <path d="M2 10.4 A10.5 10.5 0 0 0 7.7 7.2" fill="none" stroke="#d9e5de" stroke-opacity=".65" stroke-width=".8" stroke-linecap="round" />
</svg>
