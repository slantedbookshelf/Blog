---
import ThemeToggle from './ThemeToggle.astro';
import { SITE, withBase } from '../lib/site';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/tags/', label: '标签' },
  { href: '/categories/', label: '分类' },
  { href: '/review/', label: '八股复习' },
  { href: '/about/', label: '关于' }
];
---

<header class="site-header">
  <nav class="nav-shell" aria-label="主导航">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark" aria-hidden="true">谢</span>
      <span>{SITE.title}</span>
    </a>

    <input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="打开导航" />
    <label class="nav-toggle-label" for="nav-toggle" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <div class="nav-links">
      {navItems.map((item) => (
        <a href={withBase(item.href)}>{item.label}</a>
      ))}
      <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
      <ThemeToggle />
    </div>
  </nav>
</header>
