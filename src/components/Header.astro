---
import ThemeToggle from './ThemeToggle.astro';
import { SITE, withBase } from '../lib/site';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/practice/', label: '刷题' },
  { href: '/categories/', label: '分类' },
  { href: '/review/', label: '八股复习' },
  { href: '/about/', label: '关于' }
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const basePath = withBase('/').replace(/\/$/, '');
const isActive = (href: string) => {
  const destination = withBase(href).replace(/\/$/, '') || '/';
  return href === '/' ? path === destination : path === destination || path.startsWith(`${destination}/`) || (href === '/blog/' && path.startsWith(`${basePath}/posts/`));
};
---

<header class="site-header">
  <nav class="nav-shell" aria-label="主导航">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark" aria-hidden="true">谢</span>
      <span>{SITE.title}</span>
    </a>

    <input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="打开导航" />
    <label class="nav-toggle-label" for="nav-toggle" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <div class="nav-links">
      <div class="nav-tabs" data-nav-tabs>
        <span class="nav-tabs__cursor" aria-hidden="true"></span>
        {navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
      <a class="nav-github" href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const tabs = document.querySelector<HTMLElement>('[data-nav-tabs]');
  if (tabs) {
    const cursor = tabs.querySelector<HTMLElement>('.nav-tabs__cursor');
    const links = Array.from(tabs.querySelectorAll<HTMLAnchorElement>('a'));
    const current = tabs.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
    let hovered: HTMLAnchorElement | null = null;
    let focused: HTMLAnchorElement | null = null;
    const position = () => {
      if (!cursor) return;
      const active = hovered || focused || current;
      if (!active) { cursor.style.opacity = '0'; return; }
      cursor.style.width = `${active.offsetWidth}px`;
      cursor.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
      cursor.style.height = `${active.offsetHeight}px`;
      cursor.style.opacity = '1';
    };
    links.forEach((link) => {
      link.addEventListener('pointerenter', (event) => { if (event.pointerType !== 'touch') { hovered = link; position(); } });
      link.addEventListener('focus', () => { focused = link; position(); });
      link.addEventListener('blur', () => { focused = null; position(); });
    });
    tabs.addEventListener('pointerleave', () => { hovered = null; position(); });
    new ResizeObserver(position).observe(tabs);
    position();
    tabs.classList.add('is-ready');
  }
</script>

