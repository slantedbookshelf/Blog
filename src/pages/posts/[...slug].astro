---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostSlug, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: getPostSlug(post.id) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const index = posts.findIndex((item) => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
type Difficulty = '简单' | '中等' | '困难';

const difficultyClass: Record<Difficulty, string> = {
  简单: 'difficulty-badge--easy',
  中等: 'difficulty-badge--medium',
  困难: 'difficulty-badge--hard'
};
const difficultyPattern = /\s*(简单|中等|困难)$/;
const indexGroups: {
  title: string;
  slug: string;
  items: { title: string; slug: string; difficulty?: Difficulty }[];
}[] = [];

for (const heading of headings) {
  if (heading.depth === 2) {
    indexGroups.push({ title: heading.text, slug: heading.slug, items: [] });
  }

  if (heading.depth === 3 && /^\d+、/.test(heading.text)) {
    if (!indexGroups.length) {
      indexGroups.push({ title: '题目索引', slug: heading.slug, items: [] });
    }

    const difficulty = heading.text.match(difficultyPattern)?.[1] as Difficulty | undefined;

    indexGroups[indexGroups.length - 1].items.push({
      title: heading.text.replace(difficultyPattern, '').trim(),
      slug: heading.slug,
      difficulty
    });
  }
}

const problemCount = indexGroups.reduce((total, group) => total + group.items.length, 0);
const showProblemIndex = problemCount >= 12;
---

<BaseLayout title={post.data.title} description={post.data.description} article wide={showProblemIndex}>
  <div class:list={['article-layout', showProblemIndex && 'article-layout--with-index']}>
    {showProblemIndex && (
      <aside class="problem-index" aria-label="题目索引">
        <div class="problem-index__inner">
          <p class="problem-index__label">题目索引</p>
          <nav>
            {indexGroups.map((group) => group.items.length > 0 && (
              <section class="problem-index__group">
                <a class="problem-index__category" href={`#${group.slug}`}>{group.title}</a>
                <ol>
                  {group.items.map((item) => (
                    <li>
                      <a href={`#${item.slug}`}>
                        <span class="problem-index__item-title">{item.title}</span>
                        {item.difficulty && (
                          <span class:list={['difficulty-badge', difficultyClass[item.difficulty]]}>
                            {item.difficulty}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </nav>
        </div>
      </aside>
    )}

    <div class="article-layout__body">
      <article class="article">
        <header class="article-header">
          <div class="post-card__meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <a href={withBase(`/categories/${encodeURIComponent(post.data.category)}/`)}>
              {post.data.category}
            </a>
          </div>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
          <div class="tag-row">
            {post.data.tags.map((tag) => (
              <a class="tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
            ))}
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>
      </article>

      <nav class="post-nav" aria-label="文章导航">
        {previous ? (
          <a href={withBase(`/posts/${getPostSlug(previous.id)}/`)}>
            <span>上一篇</span>
            {previous.data.title}
          </a>
        ) : <span></span>}
        {next ? (
          <a href={withBase(`/posts/${getPostSlug(next.id)}/`)}>
            <span>下一篇</span>
            {next.data.title}
          </a>
        ) : <span></span>}
      </nav>
    </div>
  </div>
</BaseLayout>
