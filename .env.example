# Frontend, used at Astro build time. GitHub Pages should point this to your deployed Serverless API.
PUBLIC_AI_API_URL=https://your-netlify-site.netlify.app/api/chat

# Serverless API, set these in Netlify environment variables.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=700

# Comma-separated origins allowed to call the Serverless API.
AI_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,https://jiasuxie92-jpg.github.io

# Optional. If your Netlify function is deployed separately from the static blog,
# point it to the GitHub Pages generated context JSON.
BLOG_CONTEXT_URL=https://jiasuxie92-jpg.github.io/Blog/ai-context.json
