---
import Shelfy from '../components/Shelfy.astro';
---
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Shelfy · 角色工作台</title></head>
<body><main><header><a href="/">SlantedBookshelf <span>／ 角色实验室</span></a><small>CHARACTER STUDY &nbsp; / &nbsp; 001</small></header>
<section class="intro"><p class="eyebrow">A LITTLE SHELF. A CURIOUS SOUL.</p><h1>你好，我是 Shelfy<span>。</span></h1><p>把好奇心放进书架，让每一天都长出一点新知识。</p></section>
<shelfy-studio><div class="stage"><div class="stage-label">SHELFY <span>初见 · 第一阶段</span></div><div class="character"><Shelfy/></div><div class="caption"><span class="dot"></span><span id="status" aria-live="polite">Idle · 安静地陪你学习</span></div><p class="stage-note">有一点倾斜，也有一点可爱。</p></div>
<aside><p class="eyebrow">PLAYGROUND</p><h2>认识一下小书架</h2><p class="muted">好奇、认真，偶尔有点冒失。<br/>试着和她打个招呼吧。</p><div class="divider"></div><label>动作测试 <small>MOTION</small></label><div class="actions"><button data-action="idle">◌ <b>Idle</b><span>待机</span></button><button data-action="happy">♡ <b>Happy</b><span>开心</span></button><button data-action="blink">⌁ <b>Blink</b><span>眨眼</span></button></div><label for="size">角色大小 <output id="size-value">300 px</output></label><input id="size" type="range" min="150" max="300" value="300" step="10"/><div class="range-label"><span>150 px</span><span>300 px</span></div><label>背景氛围</label><div class="themes"><button data-theme="light" aria-pressed="true">☼ 浅色纸张</button><button data-theme="dark" aria-pressed="false">☾ 深色夜晚</button></div><div class="divider"></div><div class="utilities"><button data-action="pause">暂停动画</button><button data-action="reset">↺ 重置角色</button></div><p class="hint">自然眨眼间隔 3–7 秒。开启系统减少动态效果时，自动保持安静。</p></aside></shelfy-studio>
<footer><span>SHELFY / A SLANTEDBOOKSHELF ORIGINAL</span><span>慢慢学习，慢慢长大。 ✧</span></footer></main></body></html>
<script>
import { ShelfyAnimator } from '../lib/animator';
class Studio extends HTMLElement {
 cleanup?:()=>void;
 connectedCallback(){const animator=new ShelfyAnimator(this.querySelector('svg')!);const abort=new AbortController();
 this.addEventListener('click',(event)=>{const button=(event.target as Element).closest('button');if(!button)return;
 const action=button.dataset.action;
 if(action==='happy')animator.happy();if(action==='blink')animator.blink();if(action==='idle'||action==='reset')animator.reset();
 if(action==='pause'){animator.toggle();button.textContent=animator.paused?'继续动画':'暂停动画';this.querySelector('#status')!.textContent=animator.paused?'Paused · 休息一下':'Idle · 安静地陪你学习';}
 if(button.dataset.theme){this.dataset.theme=button.dataset.theme;this.querySelectorAll('[data-theme]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}
 },{signal:abort.signal});
 this.querySelector('input')!.addEventListener('input',event=>{const value=(event.target as HTMLInputElement).value;this.style.setProperty('--size',`${value}px`);this.querySelector('output')!.textContent=`${value} px`;},{signal:abort.signal});
 this.cleanup=()=>{abort.abort();animator.destroy();};}
 disconnectedCallback(){this.cleanup?.();}
}
customElements.define('shelfy-studio',Studio);
</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f7f5f0;color:#473e35;font-family:'Segoe UI','Microsoft YaHei',sans-serif}main{max-width:1160px;margin:auto;padding:32px 40px}header,footer{display:flex;justify-content:space-between;align-items:center}header{padding-bottom:28px;border-bottom:1px solid #dfd9cf}a{color:inherit;text-decoration:none;font-weight:650}header span,small,.muted{color:#827a70}small,.eyebrow,footer{font-size:10px;letter-spacing:1.5px}.intro{margin:42px 0 32px}.eyebrow{color:#8c9273;font-weight:650}h1{font-size:38px;font-weight:550;letter-spacing:-1px;margin:14px 0}h1 span{color:#a3a986}.intro>p:last-child{font-size:13px;color:#827a70}shelfy-studio{display:grid;grid-template-columns:1.6fr 1fr;border:1px solid #dfd9cf;border-radius:18px;overflow:hidden;--size:300px}.stage{position:relative;min-height:510px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 42%,#fffcf4,#eee9dd);transition:background .3s}.stage-label{position:absolute;top:25px;left:28px;font-size:11px;letter-spacing:2px}.stage-label span{margin-left:12px;letter-spacing:0;color:#918879}.character{width:var(--size);height:370px;display:flex;align-items:center;justify-content:center}.character svg{width:100%;overflow:visible}.caption{display:flex;align-items:center;gap:8px;font-size:11px;color:#827a70}.dot{width:6px;height:6px;border-radius:50%;background:#8eaa88}.stage-note{font-size:11px;color:#9a9184;margin:14px 0 0}aside{background:#fcfaf6;padding:32px}h2{font-size:21px;font-weight:550;margin:12px 0}.muted{font-size:12px;line-height:1.9}.divider{height:1px;background:#e8e1d6;margin:24px 0}label{display:flex;justify-content:space-between;font-size:12px;margin:20px 0 12px}button{font:inherit;color:inherit;background:transparent;border:1px solid #ded7cc;border-radius:8px;cursor:pointer;padding:12px;transition:background .15s}button:hover{background:#eee9df}button:focus-visible,input:focus-visible{outline:2px solid #825a46;outline-offset:4px}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.actions button{font-size:19px}.actions b,.actions span{display:block;font-size:12px;font-weight:500;margin-top:6px}.actions span{font-size:10px;color:#918879}.actions button:nth-child(2){background:#eef0e6;border-color:#bac3a4}input{width:100%;accent-color:#8b9673}.range-label{display:flex;justify-content:space-between;font-size:10px;color:#9a9184}.themes,.utilities{display:flex;gap:8px}.themes button,.utilities button{flex:1;font-size:11px}.themes [aria-pressed=true]{border-color:#899675;background:#eef0e6}.hint{font-size:10px;line-height:1.8;color:#9a9184;margin-bottom:0}footer{margin-top:28px;color:#918879;font-size:9px}[data-theme=dark] .stage{background:radial-gradient(ellipse at 50% 40%,#45433f,#272b2b)}[data-theme=dark] .stage-label,[data-theme=dark] .caption,[data-theme=dark] .stage-note{color:#d1c8b8}@media(max-width:760px){main{padding:22px}header small{display:none}.intro{margin-top:32px}h1{font-size:29px}shelfy-studio{grid-template-columns:1fr}.stage{min-height:460px}footer{gap:20px;font-size:8px}}
</style>
