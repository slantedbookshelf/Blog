---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedProfileCard from '../components/AnimatedProfileCard.astro';
import CascadeText from '../components/CascadeText.astro';
import KineticPhotoStack from '../components/KineticPhotoStack.astro';
import PostCard from '../components/PostCard.astro';
import { vibeWorks } from '../data/profile';
import { SITE, daysSince, estimateReadingTime, formatDate, getPostSlug, withBase } from '../lib/site';
import jevCover from '../content/posts/what-is-jev-pics/jev-system-one-cover.jpeg';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestPost = posts[0];
const latestPostSlug = latestPost ? getPostSlug(latestPost.id) : '';
const latestPostHref = latestPost ? withBase(`/posts/${latestPostSlug}/`) : '';
const latestPostCover = latestPostSlug === 'what-is-jev' ? jevCover : undefined;
const lastUpdated = posts[0]?.data.updatedDate ?? posts[0]?.data.pubDate;
const categoryCounts = posts.reduce<Record<string, number>>((acc, post) => {
  acc[post.data.category] = (acc[post.data.category] ?? 0) + 1;
  return acc;
}, {});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const runningDays = daysSince(SITE.startDate);
---

<BaseLayout title="首页" wide>
  <section class="home-top"> 
    <div class="home-top__copy">
      <p class="section-label">welcome to</p>
      <h1 class="home-title"><CascadeText text={SITE.title} /></h1>
      <p>{SITE.description}</p>
    </div>
    <KineticPhotoStack />
    <dl class="metric-grid" aria-label="站点数据">
      <div>
        <dt>博客数</dt>
        <dd>{posts.length}</dd>
      </div>
      <div>
        <dt>vibe coding作品</dt>
        <dd>{vibeWorks.length}</dd>
      </div>
      <div>
        <dt>陪你走过</dt>
        <dd>{runningDays}d</dd>
      </div>
      <div>
        <dt>最近更新</dt>
        <dd>{lastUpdated ? formatDate(lastUpdated) : '暂无'}</dd>
      </div>
    </dl>
  </section>

  <div class="content-layout">
    <main class="content-main">
      {latestPost && (
        <section class="panel latest-panel" aria-label="最近更新">
          <div class="panel__header">
            <h2>最近更新</h2>
            <a href={latestPostHref}>打开</a>
          </div>
          <article class:list={['latest-entry', { 'latest-entry--with-cover': latestPostCover }]}>
            <div class="latest-entry__body">
              <h3>
                <a href={latestPostHref}>{latestPost.data.title}</a>
              </h3>
              <p>{latestPost.data.description}</p>
              <div class="post-card__meta">
                <time class="post-card__date" datetime={latestPost.data.pubDate.toISOString()}>{formatDate(latestPost.data.pubDate)}</time>
                <span>{latestPost.data.category}</span>
                <span>{estimateReadingTime(latestPost.body ?? latestPost.data.description)} 分钟</span>
                {latestPost.data.tags.slice(0, 4).map((tag) => (
                  <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
                ))}
              </div>
            </div>
            {latestPostCover && (
              <a class="latest-entry__cover" href={latestPostHref} aria-label={`阅读《${latestPost.data.title}》`}>
                <Image
                  src={latestPostCover}
                  alt="Jev System One 模型封面插图"
                  width={360}
                  height={203}
                />
              </a>
            )}
          </article>
        </section>
      )}

      <section class="panel works-panel" aria-label="vibe coding作品">
        <div class="panel__header">
          <h2>vibe coding作品</h2>
          <a href={`${SITE.github}?tab=repositories`} target="_blank" rel="noreferrer">仓库</a>
        </div>
        <div class="works-list">
          {vibeWorks.map((work) => (
            <article class:list={['work-item', { 'work-item--preview': work.preview }]}>
              {work.preview && (
                <img class="work-item__preview" src={withBase(work.preview.src)} alt={work.preview.alt}
                  style={{ objectPosition: work.preview.position ?? 'center' }}
                  width="960" height="640" loading="lazy" decoding="async" />
              )}
              <div class="work-item__body">
                <p class="work-item__name">{work.name}</p>
                <h3>
                  <a href={work.href} target="_blank" rel="noreferrer">{work.title}</a>
                </h3>
                <p>{work.description}</p>
              </div>
              <div class="work-item__footer">
                <div class="work-item__stack" aria-label={`${work.title} 技术栈`}>
                  {work.stack.map((item) => <span>{item}</span>)}
                </div>
                <a class="repo-link" href={work.href} target="_blank" rel="noreferrer">GitHub</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="panel articles-panel" aria-label="文章列表">
        <div class="panel__header">
          <h2>全部文章</h2>
          <a href={withBase('/blog/')}>归档</a>
        </div>
        <div class="post-list post-list--dense">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    </main>

    <aside class="content-sidebar" aria-label="站点侧栏">
      <AnimatedProfileCard
        name={SITE.author}
        location={`${SITE.university}，计算机视觉方向`}
        bio="信息与通信工程硕士在读。这里记录学习、技术探索与 AI 实践，欢迎一起交流。"
        github={SITE.github}
        email={SITE.email}
      />

      <section class="panel">
        <div class="panel__header">
          <h2>分类</h2>
          <a href={withBase('/categories/')}>全部</a>
        </div>
        <div class="compact-list">
          {categories.map(([category, count]) => (
            <a href={withBase(`/categories/${encodeURIComponent(category)}/`)}>
              <span>{category}</span>
              <b>{count}</b>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Image, fading surface, then copy: keep text opaque in both themes. */
  .work-item--preview {
    isolation: isolate;
    min-height: 230px;
  }

  .work-item--preview:first-child { min-height: 200px; }

  .work-item__preview {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .work-item--preview::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg,
      var(--surface) 0%, var(--surface) 38%,
      color-mix(in srgb, var(--surface) 97%, transparent) 49%,
      color-mix(in srgb, var(--surface) 75%, transparent) 61%,
      color-mix(in srgb, var(--surface) 20%, transparent) 78%,
      transparent 100%);
  }

  .work-item--preview .work-item__body { width: 66%; }
  .work-item--preview .work-item__name { overflow-wrap: anywhere; }
  .work-item--preview p:not(.work-item__name) { -webkit-line-clamp: unset; }
  .work-item--preview .work-item__footer { position: relative; }
  .work-item--preview .work-item__stack { max-width: 70%; }
  .work-item--preview .repo-link { background: var(--surface); }

  @media (prefers-reduced-motion: no-preference) {
    .work-item__preview { transition: transform 350ms ease; }
    .work-item--preview:is(:hover, :focus-within) .work-item__preview { transform: scale(1.035); }
  }

  @media (max-width: 640px) {
    .work-item--preview, .work-item--preview:first-child { min-height: 220px; }
    .work-item--preview .work-item__footer { flex-direction: row; align-items: end; }
  }
</style>

