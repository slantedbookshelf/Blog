---
interface Props {
  article?: boolean;
}

const { article = false } = Astro.props;
---

<div class="ambient-backdrop" aria-hidden="true">
  <span class="ambient-blob ambient-blob--one"></span>
  <span class="ambient-blob ambient-blob--two"></span>
  <span class="ambient-blob ambient-blob--three"></span>
</div>
<div
  class:list={['kinetic-grid', article && 'kinetic-grid--article']}
  data-kinetic-grid
  data-article={article ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="kinetic-grid__canvas" data-kinetic-grid-canvas></canvas>
</div>
{article && <div class="reading-progress" data-reading-progress aria-hidden="true"></div>}

<script src="../scripts/siteEffects.ts"></script>
